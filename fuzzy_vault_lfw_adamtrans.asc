namespace {

constexpr int32_t kEmbeddingDimension = 512;
constexpr int32_t kLsscBitsPerFeature = 3;
constexpr int32_t kTemplateBits = 1536;
constexpr int32_t kChunkBits = 16;
constexpr int32_t kTokenCount = kTemplateBits / kChunkBits;
#ifdef FUZZY_VAULT_FULL
constexpr int32_t kPairCount = 6000;
#else
constexpr int32_t kPairCount = 10;
constexpr int32_t kPositivePairCount = 5;
#endif
constexpr int32_t kEmbeddingBatch = kPairCount * 2;
constexpr int32_t kCannWorkerCount = 20;
constexpr int32_t kMaskDropPerThousand = 450;

// WiFaKey uses 5G-NR Base Graph 2. With Z=10, one 512-bit
// AdaMTrans block plus eight zero padding bits maps to one N=520 word.
constexpr int32_t kBlocksPerTemplate = 3;
constexpr int32_t kBaseRows = 42;
constexpr int32_t kBaseColumns = 52;
constexpr int32_t kLiftSize = 10;
constexpr int32_t kCheckCount = kBaseRows * kLiftSize;
constexpr int32_t kVariableCount = kBaseColumns * kLiftSize;
constexpr int32_t kInformationCount = 100;
constexpr int32_t kEdgeCount = 1970;
constexpr int32_t kCodeBlockBatch = kPairCount * kBlocksPerTemplate;
constexpr int32_t kMaxIterations = 50;
constexpr float kChannelLlr = 4.0F;
constexpr float kMinSumNormalization = 0.75F;

constexpr int32_t kPrime = 2147483647;
constexpr int32_t kPolynomialDegree = 7;
constexpr int32_t kRequiredMatchCount = kPolynomialDegree + 1;
// Eight points are mathematically sufficient for degree-7 interpolation, but
// the hybrid protocol requires overlap across all three LDPC-reconstructed
// blocks. A threshold above 64 prevents one or two exact 512-bit blocks from
// unlocking the Vault by themselves.
constexpr int32_t kVaultUnlockMatchCount = 80;
constexpr int32_t kGenuineCount = kTokenCount;
constexpr int32_t kChaffCount = 96;
constexpr int32_t kVaultPointCount = kGenuineCount + kChaffCount;
constexpr int32_t kQueryCount = kTokenCount;
constexpr int32_t kMaxMatchedCount = kTokenCount;
constexpr int32_t kChaffDomainStart = 10000000;

class FuzzyVaultLfwAdaMTransKernel {
public:
    __aicore__ inline FuzzyVaultLfwAdaMTransKernel() = default;

    __aicore__ inline void Init(
        GM_ADDR embeddings,
        GM_ADDR thresholds,
        GM_ADDR mask,
        GM_ADDR binaryTemplates,
        GM_ADDR sampleCount)
    {
        sampleCountGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(sampleCount), 1);
        const int32_t count = sampleCountGm_.GetValue(0);
        embeddingsGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ float*>(embeddings), count * kEmbeddingDimension);
        thresholdsGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(thresholds), 3);
        maskGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(mask), kTemplateBits);
        binaryTemplatesGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ uint16_t*>(binaryTemplates), count * kTemplateBits);
    }

    __aicore__ inline void Run()
    {
        const int32_t count = sampleCountGm_.GetValue(0);
        const int32_t worker = AscendC::GetBlockIdx();
        const int32_t workers = static_cast<int32_t>(AscendC::GetBlockNum());
        for (int32_t sample = worker; sample < count; sample += workers) {
            ProcessSample(sample);
        }
    }

private:
    __aicore__ inline void ProcessSample(int32_t sample)
    {
        const int32_t embeddingBase = sample * kEmbeddingDimension;
        const int32_t templateBase = sample * kTemplateBits;
        for (int32_t feature = 0; feature < kEmbeddingDimension; ++feature) {
            const float value = embeddingsGm_.GetValue(embeddingBase + feature);
            int32_t level = 0;
            level += value >= thresholdsGm_.GetValue(0) ? 1 : 0;
            level += value >= thresholdsGm_.GetValue(1) ? 1 : 0;
            level += value >= thresholdsGm_.GetValue(2) ? 1 : 0;
            const int32_t base = feature * kLsscBitsPerFeature;
            binaryTemplatesGm_.SetValue(
                templateBase + base + 0,
                static_cast<uint16_t>(level >= 3 ? 1 : 0) & maskGm_.GetValue(base + 0));
            binaryTemplatesGm_.SetValue(
                templateBase + base + 1,
                static_cast<uint16_t>(level >= 2 ? 1 : 0) & maskGm_.GetValue(base + 1));
            binaryTemplatesGm_.SetValue(
                templateBase + base + 2,
                static_cast<uint16_t>(level >= 1 ? 1 : 0) & maskGm_.GetValue(base + 2));
        }
    }

    AscendC::GlobalTensor<float> embeddingsGm_;
    AscendC::GlobalTensor<float> thresholdsGm_;
    AscendC::GlobalTensor<uint16_t> maskGm_;
    AscendC::GlobalTensor<uint16_t> binaryTemplatesGm_;
    AscendC::GlobalTensor<int32_t> sampleCountGm_;
};

class FuzzyVaultLfwLdpcKernel {
public:
    __aicore__ inline FuzzyVaultLfwLdpcKernel() = default;

    __aicore__ inline void Init(
        GM_ADDR probe,
        GM_ADDR helper,
        GM_ADDR checkOffsets,
        GM_ADDR checkVariables,
        GM_ADDR variableOffsets,
        GM_ADDR variableEdges,
        GM_ADDR reconstructedWitness,
        GM_ADDR decodeOk,
        GM_ADDR syndromeWeight,
        GM_ADDR iterations,
        GM_ADDR sampleCount)
    {
        sampleCountGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(sampleCount), 1);
        const int32_t count = sampleCountGm_.GetValue(0);
        probeGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ uint16_t*>(probe), count * kVariableCount);
        helperGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ uint16_t*>(helper), count * kVariableCount);
        checkOffsetsGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(checkOffsets), kCheckCount + 1);
        checkVariablesGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(checkVariables), kEdgeCount);
        variableOffsetsGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(variableOffsets), kVariableCount + 1);
        variableEdgesGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(variableEdges), kEdgeCount);
        reconstructedWitnessGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ uint16_t*>(reconstructedWitness),
            count * kVariableCount);
        decodeOkGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(decodeOk), count);
        syndromeWeightGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(syndromeWeight), count);
        iterationsGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(iterations), count);

        pipe_.InitBuffer(channelLlrBuffer_, kVariableCount * sizeof(float));
        pipe_.InitBuffer(qMessageBuffer_, kEdgeCount * sizeof(float));
        pipe_.InitBuffer(rMessageBuffer_, kEdgeCount * sizeof(float));
        pipe_.InitBuffer(hardDecisionBuffer_, kVariableCount * sizeof(uint16_t));
    }

    __aicore__ inline void Run()
    {
        AscendC::LocalTensor<float> channelLlr = channelLlrBuffer_.Get<float>();
        AscendC::LocalTensor<float> qMessage = qMessageBuffer_.Get<float>();
        AscendC::LocalTensor<float> rMessage = rMessageBuffer_.Get<float>();
        AscendC::LocalTensor<uint16_t> hardDecision = hardDecisionBuffer_.Get<uint16_t>();

        const int32_t count = sampleCountGm_.GetValue(0);
        const int32_t worker = AscendC::GetBlockIdx();
        const int32_t workers = static_cast<int32_t>(AscendC::GetBlockNum());
        for (int32_t sample = worker; sample < count; sample += workers) {
            ProcessSample(sample, channelLlr, qMessage, rMessage, hardDecision);
        }
    }

private:
    __aicore__ inline void ProcessSample(
        int32_t sample,
        AscendC::LocalTensor<float>& channelLlr,
        AscendC::LocalTensor<float>& qMessage,
        AscendC::LocalTensor<float>& rMessage,
        AscendC::LocalTensor<uint16_t>& hardDecision)
    {
        const int32_t sampleBase = sample * kVariableCount;
        for (int32_t variable = 0; variable < kVariableCount; ++variable) {
            const uint16_t received =
                probeGm_.GetValue(sampleBase + variable) ^
                helperGm_.GetValue(sampleBase + variable);
            const float llr = received == 0 ? kChannelLlr : -kChannelLlr;
            channelLlr.SetValue(variable, llr);
            hardDecision.SetValue(variable, received);
        }
        for (int32_t edge = 0; edge < kEdgeCount; ++edge) {
            qMessage.SetValue(
                edge,
                channelLlr.GetValue(checkVariablesGm_.GetValue(edge)));
            rMessage.SetValue(edge, 0.0F);
        }

        int32_t syndromeWeight = kCheckCount;
        int32_t completedIterations = 0;
        for (int32_t iteration = 0; iteration < kMaxIterations; ++iteration) {
            for (int32_t check = 0; check < kCheckCount; ++check) {
                const int32_t begin = checkOffsetsGm_.GetValue(check);
                const int32_t end = checkOffsetsGm_.GetValue(check + 1);
                float minimum = 1.0e30F;
                float secondMinimum = 1.0e30F;
                int32_t minimumEdge = -1;
                int32_t signProduct = 1;
                for (int32_t edge = begin; edge < end; ++edge) {
                    const float value = qMessage.GetValue(edge);
                    const float magnitude = value < 0.0F ? -value : value;
                    signProduct *= value < 0.0F ? -1 : 1;
                    if (magnitude < minimum) {
                        secondMinimum = minimum;
                        minimum = magnitude;
                        minimumEdge = edge;
                    } else if (magnitude < secondMinimum) {
                        secondMinimum = magnitude;
                    }
                }
                for (int32_t edge = begin; edge < end; ++edge) {
                    const int32_t ownSign = qMessage.GetValue(edge) < 0.0F ? -1 : 1;
                    const float magnitude = edge == minimumEdge ? secondMinimum : minimum;
                    rMessage.SetValue(
                        edge,
                        kMinSumNormalization *
                            static_cast<float>(signProduct * ownSign) * magnitude);
                }
            }

            for (int32_t variable = 0; variable < kVariableCount; ++variable) {
                float total = channelLlr.GetValue(variable);
                const int32_t begin = variableOffsetsGm_.GetValue(variable);
                const int32_t end = variableOffsetsGm_.GetValue(variable + 1);
                for (int32_t index = begin; index < end; ++index) {
                    total += rMessage.GetValue(variableEdgesGm_.GetValue(index));
                }
                hardDecision.SetValue(variable, total < 0.0F ? 1 : 0);
                for (int32_t index = begin; index < end; ++index) {
                    const int32_t edge = variableEdgesGm_.GetValue(index);
                    qMessage.SetValue(edge, total - rMessage.GetValue(edge));
                }
            }

            syndromeWeight = ComputeSyndromeWeight(hardDecision);
            completedIterations = iteration + 1;
            if (syndromeWeight == 0) {
                break;
            }
        }

        for (int32_t variable = 0; variable < kVariableCount; ++variable) {
            reconstructedWitnessGm_.SetValue(
                sampleBase + variable,
                helperGm_.GetValue(sampleBase + variable) ^
                    hardDecision.GetValue(variable));
        }
        decodeOkGm_.SetValue(sample, syndromeWeight == 0 ? 1 : 0);
        syndromeWeightGm_.SetValue(sample, syndromeWeight);
        iterationsGm_.SetValue(sample, completedIterations);
    }

    __aicore__ inline int32_t ComputeSyndromeWeight(
        AscendC::LocalTensor<uint16_t>& hardDecision)
    {
        int32_t weight = 0;
        for (int32_t check = 0; check < kCheckCount; ++check) {
            uint16_t parity = 0;
            const int32_t begin = checkOffsetsGm_.GetValue(check);
            const int32_t end = checkOffsetsGm_.GetValue(check + 1);
            for (int32_t edge = begin; edge < end; ++edge) {
                parity ^= hardDecision.GetValue(checkVariablesGm_.GetValue(edge));
            }
            weight += parity == 0 ? 0 : 1;
        }
        return weight;
    }

    AscendC::TPipe pipe_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> channelLlrBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> qMessageBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rMessageBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> hardDecisionBuffer_;
    AscendC::GlobalTensor<uint16_t> probeGm_;
    AscendC::GlobalTensor<uint16_t> helperGm_;
    AscendC::GlobalTensor<int32_t> checkOffsetsGm_;
    AscendC::GlobalTensor<int32_t> checkVariablesGm_;
    AscendC::GlobalTensor<int32_t> variableOffsetsGm_;
    AscendC::GlobalTensor<int32_t> variableEdgesGm_;
    AscendC::GlobalTensor<uint16_t> reconstructedWitnessGm_;
    AscendC::GlobalTensor<int32_t> decodeOkGm_;
    AscendC::GlobalTensor<int32_t> syndromeWeightGm_;
    AscendC::GlobalTensor<int32_t> iterationsGm_;
    AscendC::GlobalTensor<int32_t> sampleCountGm_;
};

class FuzzyVaultLfwMatchKernel {
public:
    __aicore__ inline FuzzyVaultLfwMatchKernel() = default;

    __aicore__ inline void Init(
        GM_ADDR vaultX,
        GM_ADDR vaultY,
        GM_ADDR queryX,
        GM_ADDR matchedX,
        GM_ADDR matchedY,
        GM_ADDR matchCount,
        GM_ADDR sampleCount)
    {
        sampleCountGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(sampleCount), 1);
        const int32_t count = sampleCountGm_.GetValue(0);
        vaultXGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(vaultX), count * kVaultPointCount);
        vaultYGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(vaultY), count * kVaultPointCount);
        queryXGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(queryX), count * kQueryCount);
        matchedXGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(matchedX), count * kMaxMatchedCount);
        matchedYGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(matchedY), count * kMaxMatchedCount);
        matchCountGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(matchCount), count);
    }

    __aicore__ inline void Run()
    {
        const int32_t count = sampleCountGm_.GetValue(0);
        const int32_t worker = AscendC::GetBlockIdx();
        const int32_t workers = static_cast<int32_t>(AscendC::GetBlockNum());
        for (int32_t sample = worker; sample < count; sample += workers) {
            ProcessSample(sample);
        }
    }

private:
    __aicore__ inline void ProcessSample(int32_t sample)
    {
        const int32_t vaultBase = sample * kVaultPointCount;
        const int32_t queryBase = sample * kQueryCount;
        const int32_t matchedBase = sample * kMaxMatchedCount;
        for (int32_t index = 0; index < kMaxMatchedCount; ++index) {
            matchedXGm_.SetValue(matchedBase + index, 0);
            matchedYGm_.SetValue(matchedBase + index, 0);
        }
        int32_t matched = 0;
        for (int32_t queryIndex = 0; queryIndex < kQueryCount; ++queryIndex) {
            const int32_t query = queryXGm_.GetValue(queryBase + queryIndex);
            for (int32_t vaultIndex = 0; vaultIndex < kVaultPointCount; ++vaultIndex) {
                if (query == vaultXGm_.GetValue(vaultBase + vaultIndex)) {
                    if (matched < kMaxMatchedCount) {
                        matchedXGm_.SetValue(matchedBase + matched, query);
                        matchedYGm_.SetValue(
                            matchedBase + matched,
                            vaultYGm_.GetValue(vaultBase + vaultIndex));
                        ++matched;
                    }
                    break;
                }
            }
        }
        matchCountGm_.SetValue(sample, matched);
    }

    AscendC::GlobalTensor<int32_t> vaultXGm_;
    AscendC::GlobalTensor<int32_t> vaultYGm_;
    AscendC::GlobalTensor<int32_t> queryXGm_;
    AscendC::GlobalTensor<int32_t> matchedXGm_;
    AscendC::GlobalTensor<int32_t> matchedYGm_;
    AscendC::GlobalTensor<int32_t> matchCountGm_;
    AscendC::GlobalTensor<int32_t> sampleCountGm_;
};

struct EmbeddingDataset {
    std::vector<float> values;
    std::vector<uint8_t> labels;
    std::array<float, 3> thresholds{};
};

struct LdpcGraph {
    std::array<int32_t, kCheckCount + 1> checkOffsets{};
    std::array<int32_t, kEdgeCount> checkVariables{};
    std::array<int32_t, kVariableCount + 1> variableOffsets{};
    std::array<int32_t, kEdgeCount> variableEdges{};
    std::array<std::bitset<kVariableCount>, kCheckCount> parityRows{};
    std::vector<std::bitset<kVariableCount>> nullspaceBasis;
    int32_t rank = 0;
};

struct DecodeResult {
    std::array<uint16_t, kVariableCount> bits{};
    int32_t decodeOk = 0;
    int32_t syndromeWeight = kCheckCount;
    int32_t iterations = 0;
};

struct MatchResult {
    std::array<int32_t, kMaxMatchedCount> x{};
    std::array<int32_t, kMaxMatchedCount> y{};
    int32_t count = 0;
};

EmbeddingDataset LoadEmbeddingDataset(
    const std::string& embeddingPath,
    const std::string& labelPath)
{
    std::ifstream input(embeddingPath);
    if (!input) {
        throw std::runtime_error("cannot open embedding file: " + embeddingPath);
    }
    EmbeddingDataset dataset;
    dataset.values.reserve(12000U * kEmbeddingDimension);
    std::string line;
    double meanSum = 0.0;
    double standardDeviationSum = 0.0;
    std::size_t rowCount = 0;
    while (std::getline(input, line)) {
        const char* cursor = line.c_str();
        std::array<float, kEmbeddingDimension> row{};
        double rowMean = 0.0;
        for (int32_t column = 0; column < kEmbeddingDimension; ++column) {
            char* next = nullptr;
            const float value = std::strtof(cursor, &next);
            if (next == cursor) {
                throw std::runtime_error("invalid embedding CSV");
            }
            row[column] = value;
            rowMean += value;
            cursor = next;
            if (column + 1 < kEmbeddingDimension) {
                if (*cursor != ',') {
                    throw std::runtime_error("embedding row does not have 512 columns");
                }
                ++cursor;
            }
        }
        rowMean /= kEmbeddingDimension;
        double variance = 0.0;
        for (const float value : row) {
            const double difference = value - rowMean;
            variance += difference * difference;
            dataset.values.push_back(value);
        }
        meanSum += rowMean;
        standardDeviationSum += std::sqrt(variance / kEmbeddingDimension);
        ++rowCount;
    }
    if (rowCount != 12000) {
        throw std::runtime_error("expected 12000 ArcFace rows");
    }

    std::ifstream labels(labelPath);
    double label = 0.0;
    while (labels >> label) {
        dataset.labels.push_back(label > 0.5 ? 1 : 0);
    }
    if (dataset.labels.size() * 2 != rowCount) {
        throw std::runtime_error("LFW labels do not match embedding pairs");
    }
    const double mean = meanSum / rowCount;
    const double standardDeviation = standardDeviationSum / rowCount;
    constexpr double kNormalQuartile = 0.6744897501960817;
    dataset.thresholds = {
        static_cast<float>(mean - kNormalQuartile * standardDeviation),
        static_cast<float>(mean),
        static_cast<float>(mean + kNormalQuartile * standardDeviation),
    };
    return dataset;
}

uint32_t MixMaskIndex(uint32_t value)
{
    value ^= value >> 16U;
    value *= 0x7feb352dU;
    value ^= value >> 15U;
    value *= 0x846ca68bU;
    value ^= value >> 16U;
    return value;
}

std::array<uint16_t, kTemplateBits> BuildAdaMTransMask()
{
    std::array<uint16_t, kTemplateBits> mask{};
    for (int32_t index = 0; index < kTemplateBits; ++index) {
        mask[index] =
            MixMaskIndex(static_cast<uint32_t>(index) + 0x00C0FFEEU) % 1000U >=
                kMaskDropPerThousand
            ? 1
            : 0;
    }
    return mask;
}

std::array<uint16_t, kTemplateBits> ReferenceAdaMTrans(
    const float* embedding,
    const std::array<float, 3>& thresholds,
    const std::array<uint16_t, kTemplateBits>& mask)
{
    std::array<uint16_t, kTemplateBits> output{};
    for (int32_t feature = 0; feature < kEmbeddingDimension; ++feature) {
        int32_t level = 0;
        level += embedding[feature] >= thresholds[0] ? 1 : 0;
        level += embedding[feature] >= thresholds[1] ? 1 : 0;
        level += embedding[feature] >= thresholds[2] ? 1 : 0;
        const int32_t base = feature * kLsscBitsPerFeature;
        output[base + 0] = static_cast<uint16_t>(level >= 3 ? 1 : 0) & mask[base + 0];
        output[base + 1] = static_cast<uint16_t>(level >= 2 ? 1 : 0) & mask[base + 1];
        output[base + 2] = static_cast<uint16_t>(level >= 1 ? 1 : 0) & mask[base + 2];
    }
    return output;
}

std::array<std::array<int32_t, kBaseColumns>, kBaseRows> LoadBaseGraph()
{
    std::ifstream input(WIFAKEY_BG2_PATH);
    if (!input) {
        throw std::runtime_error("cannot open WiFaKey base graph");
    }
    std::array<std::array<int32_t, kBaseColumns>, kBaseRows> baseGraph{};
    for (int32_t row = 0; row < kBaseRows; ++row) {
        for (int32_t column = 0; column < kBaseColumns; ++column) {
            if (!(input >> baseGraph[row][column])) {
                throw std::runtime_error("invalid WiFaKey base graph dimensions");
            }
        }
    }
    return baseGraph;
}

LdpcGraph BuildLdpcGraph()
{
    const auto baseGraph = LoadBaseGraph();
    LdpcGraph graph;
    std::array<std::vector<int32_t>, kVariableCount> variableEdgeLists;
    int32_t edge = 0;
    for (int32_t baseRow = 0; baseRow < kBaseRows; ++baseRow) {
        for (int32_t liftRow = 0; liftRow < kLiftSize; ++liftRow) {
            const int32_t check = baseRow * kLiftSize + liftRow;
            graph.checkOffsets[check] = edge;
            for (int32_t baseColumn = 0; baseColumn < kBaseColumns; ++baseColumn) {
                const int32_t shift = baseGraph[baseRow][baseColumn];
                if (shift < 0) {
                    continue;
                }
                if (edge >= kEdgeCount) {
                    throw std::runtime_error("WiFaKey graph has too many edges");
                }
                const int32_t variable =
                    baseColumn * kLiftSize + (liftRow + shift) % kLiftSize;
                graph.checkVariables[edge] = variable;
                graph.parityRows[check].set(variable);
                variableEdgeLists[variable].push_back(edge);
                ++edge;
            }
        }
    }
    graph.checkOffsets[kCheckCount] = edge;
    if (edge != kEdgeCount) {
        throw std::runtime_error(
            "expected 1970 lifted edges, got " + std::to_string(edge));
    }

    int32_t variableEdgeIndex = 0;
    for (int32_t variable = 0; variable < kVariableCount; ++variable) {
        graph.variableOffsets[variable] = variableEdgeIndex;
        for (const int32_t variableEdge : variableEdgeLists[variable]) {
            graph.variableEdges[variableEdgeIndex++] = variableEdge;
        }
    }
    graph.variableOffsets[kVariableCount] = variableEdgeIndex;

    auto reducedRows = graph.parityRows;
    std::array<int32_t, kCheckCount> pivotColumns{};
    int32_t pivotRow = 0;
    for (int32_t column = 0; column < kVariableCount && pivotRow < kCheckCount; ++column) {
        int32_t candidate = pivotRow;
        while (candidate < kCheckCount && !reducedRows[candidate].test(column)) {
            ++candidate;
        }
        if (candidate == kCheckCount) {
            continue;
        }
        std::swap(reducedRows[pivotRow], reducedRows[candidate]);
        for (int32_t row = 0; row < kCheckCount; ++row) {
            if (row != pivotRow && reducedRows[row].test(column)) {
                reducedRows[row] ^= reducedRows[pivotRow];
            }
        }
        pivotColumns[pivotRow++] = column;
    }
    graph.rank = pivotRow;
    std::array<bool, kVariableCount> isPivot{};
    for (int32_t row = 0; row < graph.rank; ++row) {
        isPivot[pivotColumns[row]] = true;
    }
    for (int32_t freeColumn = 0; freeColumn < kVariableCount; ++freeColumn) {
        if (isPivot[freeColumn]) {
            continue;
        }
        std::bitset<kVariableCount> basis;
        basis.set(freeColumn);
        for (int32_t row = 0; row < graph.rank; ++row) {
            if (reducedRows[row].test(freeColumn)) {
                basis.set(pivotColumns[row]);
            }
        }
        graph.nullspaceBasis.push_back(basis);
    }
    if (static_cast<int32_t>(graph.nullspaceBasis.size()) != kInformationCount) {
        throw std::runtime_error("WiFaKey LDPC graph rank is not 420");
    }
    return graph;
}

int32_t SyndromeWeight(
    const LdpcGraph& graph,
    const std::array<uint16_t, kVariableCount>& bits)
{
    int32_t weight = 0;
    for (int32_t check = 0; check < kCheckCount; ++check) {
        uint16_t parity = 0;
        for (int32_t edge = graph.checkOffsets[check];
             edge < graph.checkOffsets[check + 1];
             ++edge) {
            parity ^= bits[graph.checkVariables[edge]];
        }
        weight += parity == 0 ? 0 : 1;
    }
    return weight;
}

std::array<uint16_t, kVariableCount> RandomCodeword(
    const LdpcGraph& graph,
    std::mt19937& random)
{
    std::bitset<kVariableCount> codeword;
    for (const auto& basis : graph.nullspaceBasis) {
        if ((random() & 1U) != 0U) {
            codeword ^= basis;
        }
    }
    std::array<uint16_t, kVariableCount> output{};
    for (int32_t variable = 0; variable < kVariableCount; ++variable) {
        output[variable] = codeword.test(variable) ? 1 : 0;
    }
    if (SyndromeWeight(graph, output) != 0) {
        throw std::runtime_error("generated LDPC word has non-zero syndrome");
    }
    return output;
}

DecodeResult ReferenceDecode(
    const LdpcGraph& graph,
    const std::array<uint16_t, kVariableCount>& received)
{
    std::array<float, kVariableCount> channelLlr{};
    std::array<float, kEdgeCount> qMessage{};
    std::array<float, kEdgeCount> rMessage{};
    DecodeResult result;
    for (int32_t variable = 0; variable < kVariableCount; ++variable) {
        channelLlr[variable] = received[variable] == 0 ? kChannelLlr : -kChannelLlr;
        result.bits[variable] = received[variable];
    }
    for (int32_t edge = 0; edge < kEdgeCount; ++edge) {
        qMessage[edge] = channelLlr[graph.checkVariables[edge]];
    }

    for (int32_t iteration = 0; iteration < kMaxIterations; ++iteration) {
        for (int32_t check = 0; check < kCheckCount; ++check) {
            const int32_t begin = graph.checkOffsets[check];
            const int32_t end = graph.checkOffsets[check + 1];
            float minimum = std::numeric_limits<float>::max();
            float secondMinimum = std::numeric_limits<float>::max();
            int32_t minimumEdge = -1;
            int32_t signProduct = 1;
            for (int32_t edge = begin; edge < end; ++edge) {
                const float magnitude = std::abs(qMessage[edge]);
                signProduct *= qMessage[edge] < 0.0F ? -1 : 1;
                if (magnitude < minimum) {
                    secondMinimum = minimum;
                    minimum = magnitude;
                    minimumEdge = edge;
                } else if (magnitude < secondMinimum) {
                    secondMinimum = magnitude;
                }
            }
            for (int32_t edge = begin; edge < end; ++edge) {
                const int32_t ownSign = qMessage[edge] < 0.0F ? -1 : 1;
                const float magnitude = edge == minimumEdge ? secondMinimum : minimum;
                rMessage[edge] = kMinSumNormalization *
                    static_cast<float>(signProduct * ownSign) * magnitude;
            }
        }
        for (int32_t variable = 0; variable < kVariableCount; ++variable) {
            float total = channelLlr[variable];
            for (int32_t index = graph.variableOffsets[variable];
                 index < graph.variableOffsets[variable + 1];
                 ++index) {
                total += rMessage[graph.variableEdges[index]];
            }
            result.bits[variable] = total < 0.0F ? 1 : 0;
            for (int32_t index = graph.variableOffsets[variable];
                 index < graph.variableOffsets[variable + 1];
                 ++index) {
                const int32_t edge = graph.variableEdges[index];
                qMessage[edge] = total - rMessage[edge];
            }
        }
        result.syndromeWeight = SyndromeWeight(graph, result.bits);
        result.iterations = iteration + 1;
        if (result.syndromeWeight == 0) {
            result.decodeOk = 1;
            break;
        }
    }
    return result;
}

std::array<int32_t, kTokenCount> TemplateToTokens(const uint16_t* bits)
{
    std::array<int32_t, kTokenCount> tokens{};
    for (int32_t chunk = 0; chunk < kTokenCount; ++chunk) {
        uint32_t value = 0;
        for (int32_t bit = 0; bit < kChunkBits; ++bit) {
            value |= static_cast<uint32_t>(bits[chunk * kChunkBits + bit]) << bit;
        }
        // Chunk position is part of x, so equal values at different positions
        // remain distinct and x is always less than 10,000,000.
        tokens[chunk] = 1 + chunk * 65536 + static_cast<int32_t>(value);
    }
    return tokens;
}

int32_t Mod(int64_t value)
{
    value %= kPrime;
    if (value < 0) {
        value += kPrime;
    }
    return static_cast<int32_t>(value);
}

int32_t ModPow(int32_t base, int64_t exponent)
{
    int64_t result = 1;
    int64_t factor = Mod(base);
    while (exponent > 0) {
        if ((exponent & 1) != 0) {
            result = (result * factor) % kPrime;
        }
        factor = (factor * factor) % kPrime;
        exponent >>= 1;
    }
    return static_cast<int32_t>(result);
}

int32_t EvaluatePolynomial(const FuzzyVaultLfwCoefficients& coefficients, int32_t x)
{
    int32_t value = 0;
    for (int32_t index = kPolynomialDegree; index >= 0; --index) {
        value = Mod(static_cast<int64_t>(value) * x + coefficients[index]);
    }
    return value;
}

bool InterpolatePolynomial(
    const std::array<int32_t, kMaxMatchedCount>& x,
    const std::array<int32_t, kMaxMatchedCount>& y,
    FuzzyVaultLfwCoefficients& coefficients)
{
    std::array<std::array<int32_t, kRequiredMatchCount + 1>, kRequiredMatchCount> matrix{};
    for (int32_t row = 0; row < kRequiredMatchCount; ++row) {
        int32_t power = 1;
        for (int32_t column = 0; column < kRequiredMatchCount; ++column) {
            matrix[row][column] = power;
            power = Mod(static_cast<int64_t>(power) * x[row]);
        }
        matrix[row][kRequiredMatchCount] = Mod(y[row]);
    }
    for (int32_t column = 0; column < kRequiredMatchCount; ++column) {
        int32_t pivot = column;
        while (pivot < kRequiredMatchCount && matrix[pivot][column] == 0) {
            ++pivot;
        }
        if (pivot == kRequiredMatchCount) {
            return false;
        }
        std::swap(matrix[column], matrix[pivot]);
        const int32_t inverse = ModPow(matrix[column][column], kPrime - 2LL);
        for (int32_t item = column; item <= kRequiredMatchCount; ++item) {
            matrix[column][item] =
                Mod(static_cast<int64_t>(matrix[column][item]) * inverse);
        }
        for (int32_t row = 0; row < kRequiredMatchCount; ++row) {
            if (row == column) {
                continue;
            }
            const int32_t factor = matrix[row][column];
            for (int32_t item = column; item <= kRequiredMatchCount; ++item) {
                matrix[row][item] = Mod(
                    matrix[row][item] -
                    static_cast<int64_t>(factor) * matrix[column][item]);
            }
        }
    }
    for (int32_t index = 0; index < kRequiredMatchCount; ++index) {
        coefficients[index] = matrix[index][kRequiredMatchCount];
    }
    return true;
}

uint64_t Random64(std::mt19937& random)
{
    return (static_cast<uint64_t>(random()) << 32U) | random();
}

int32_t RandomFieldValue(std::mt19937& random)
{
    return static_cast<int32_t>(Random64(random) % static_cast<uint64_t>(kPrime));
}

MatchResult ReferenceMatch(
    const int32_t* vaultX,
    const int32_t* vaultY,
    const int32_t* queryX)
{
    MatchResult result;
    for (int32_t queryIndex = 0; queryIndex < kQueryCount; ++queryIndex) {
        for (int32_t vaultIndex = 0; vaultIndex < kVaultPointCount; ++vaultIndex) {
            if (queryX[queryIndex] == vaultX[vaultIndex]) {
                result.x[result.count] = queryX[queryIndex];
                result.y[result.count] = vaultY[vaultIndex];
                ++result.count;
                break;
            }
        }
    }
    return result;
}

void CheckAcl(aclError code, const std::string& operation)
{
    if (code != ACL_SUCCESS) {
        throw std::runtime_error(operation + " returned ACL error " + std::to_string(code));
    }
}

template <typename T>
T* AllocateDevice(std::size_t count, const std::string& name)
{
    T* pointer = nullptr;
    CheckAcl(
        aclrtMalloc(
            reinterpret_cast<void**>(&pointer),
            count * sizeof(T),
            ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc(" + name + ")");
    return pointer;
}

template <typename T>
void CopyHostToDevice(T* device, const T* host, std::size_t count, const std::string& name)
{
    const std::size_t bytes = count * sizeof(T);
    CheckAcl(aclrtMemcpy(device, bytes, host, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy " + name);
}

template <typename T>
void CopyDeviceToHost(T* host, const T* device, std::size_t count, const std::string& name)
{
    const std::size_t bytes = count * sizeof(T);
    CheckAcl(aclrtMemcpy(host, bytes, device, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy " + name);
}

} // namespace

__global__ __vector__ void fuzzy_vault_lfw_adamtrans(
    GM_ADDR embeddings,
    GM_ADDR thresholds,
    GM_ADDR mask,
    GM_ADDR binaryTemplates,
    GM_ADDR sampleCount)
{
    FuzzyVaultLfwAdaMTransKernel kernel;
    kernel.Init(embeddings, thresholds, mask, binaryTemplates, sampleCount);
    kernel.Run();
}

__global__ __vector__ void fuzzy_vault_lfw_ldpc_reconstruct(
    GM_ADDR probe,
    GM_ADDR helper,
    GM_ADDR checkOffsets,
    GM_ADDR checkVariables,
    GM_ADDR variableOffsets,
    GM_ADDR variableEdges,
    GM_ADDR reconstructedWitness,
    GM_ADDR decodeOk,
    GM_ADDR syndromeWeight,
    GM_ADDR iterations,
    GM_ADDR sampleCount)
{
    FuzzyVaultLfwLdpcKernel kernel;
    kernel.Init(
        probe,
        helper,
        checkOffsets,
        checkVariables,
        variableOffsets,
        variableEdges,
        reconstructedWitness,
        decodeOk,
        syndromeWeight,
        iterations,
        sampleCount);
    kernel.Run();
}

__global__ __vector__ void fuzzy_vault_lfw_match_points(
    GM_ADDR vaultX,
    GM_ADDR vaultY,
    GM_ADDR queryX,
    GM_ADDR matchedX,
    GM_ADDR matchedY,
    GM_ADDR matchCount,
    GM_ADDR sampleCount)
{
    FuzzyVaultLfwMatchKernel kernel;
    kernel.Init(vaultX, vaultY, queryX, matchedX, matchedY, matchCount, sampleCount);
    kernel.Run();
}

int main(int argc, char** argv)
{
    try {
        if (argc != 3) {
            std::cerr << "Usage: " << argv[0] << " EMBEDDINGS.csv LFW_ISSAME.csv" << std::endl;
            return EXIT_FAILURE;
        }
        const auto startTime = std::chrono::steady_clock::now();
#ifdef FUZZY_VAULT_FULL
        std::cout << "[FULL] Loading all 6000 LFW pairs..." << std::endl;
#else
        std::cout << "Loading ArcFace LFW embeddings..." << std::endl;
#endif
        const EmbeddingDataset dataset = LoadEmbeddingDataset(argv[1], argv[2]);
        const auto mask = BuildAdaMTransMask();
        const LdpcGraph graph = BuildLdpcGraph();
#ifdef FUZZY_VAULT_FULL
        std::cout << "[FULL] WiFaKey BG2 Z=10 LDPC N=" << kVariableCount
                  << " K=" << kVariableCount - graph.rank
                  << " CN=" << kCheckCount
                  << " edges=" << kEdgeCount
                  << " blocks=" << kCodeBlockBatch << std::endl;
#else
        std::cout << "WiFaKey BG2 Z=10 LDPC: N=" << kVariableCount
                  << " K=" << kVariableCount - graph.rank
                  << " CN=" << kCheckCount
                  << " edges=" << kEdgeCount << std::endl;
#endif

        std::vector<int32_t> pairIndices(kPairCount);
#ifdef FUZZY_VAULT_FULL
        if (dataset.labels.size() != static_cast<std::size_t>(kPairCount)) {
            throw std::runtime_error("full evaluation requires exactly 6000 pair labels");
        }
        for (int32_t pair = 0; pair < kPairCount; ++pair) {
            pairIndices[pair] = pair;
        }
#else
        int32_t positiveIndex = 0;
        int32_t negativeIndex = kPositivePairCount;
        for (std::size_t pair = 0; pair < dataset.labels.size(); ++pair) {
            if (dataset.labels[pair] != 0 && positiveIndex < kPositivePairCount) {
                pairIndices[positiveIndex++] = static_cast<int32_t>(pair);
            } else if (dataset.labels[pair] == 0 && negativeIndex < kPairCount) {
                pairIndices[negativeIndex++] = static_cast<int32_t>(pair);
            }
            if (positiveIndex == kPositivePairCount && negativeIndex == kPairCount) {
                break;
            }
        }
#endif

        std::vector<float> selectedEmbeddings(
            static_cast<std::size_t>(kEmbeddingBatch) * kEmbeddingDimension);
        std::vector<uint16_t> referenceTemplates(
            static_cast<std::size_t>(kEmbeddingBatch) * kTemplateBits);
        for (int32_t sample = 0; sample < kPairCount; ++sample) {
            for (int32_t side = 0; side < 2; ++side) {
                const int32_t outputRow = sample * 2 + side;
                const float* source = dataset.values.data() +
                    (pairIndices[sample] * 2 + side) * kEmbeddingDimension;
                std::copy(
                    source,
                    source + kEmbeddingDimension,
                    selectedEmbeddings.begin() + outputRow * kEmbeddingDimension);
                const auto reference =
                    ReferenceAdaMTrans(source, dataset.thresholds, mask);
                std::copy(
                    reference.begin(),
                    reference.end(),
                    referenceTemplates.begin() +
                        static_cast<std::size_t>(outputRow) * kTemplateBits);
            }
        }

        CheckAcl(aclInit(nullptr), "aclInit");
        CheckAcl(aclrtSetDevice(0), "aclrtSetDevice");
        aclrtStream stream = nullptr;
        CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");

        float* embeddingsDevice =
            AllocateDevice<float>(selectedEmbeddings.size(), "embeddings");
        float* thresholdsDevice = AllocateDevice<float>(3, "thresholds");
        uint16_t* maskDevice = AllocateDevice<uint16_t>(mask.size(), "mask");
        uint16_t* templatesDevice =
            AllocateDevice<uint16_t>(kEmbeddingBatch * kTemplateBits, "templates");
        int32_t* embeddingCountDevice =
            AllocateDevice<int32_t>(1, "embeddingCount");
        CopyHostToDevice(
            embeddingsDevice,
            selectedEmbeddings.data(),
            selectedEmbeddings.size(),
            "embeddings");
        CopyHostToDevice(
            thresholdsDevice, dataset.thresholds.data(), dataset.thresholds.size(), "thresholds");
        CopyHostToDevice(maskDevice, mask.data(), mask.size(), "mask");
        const int32_t embeddingCount = kEmbeddingBatch;
        CopyHostToDevice(
            embeddingCountDevice, &embeddingCount, 1, "embeddingCount");

        fuzzy_vault_lfw_adamtrans<<<kCannWorkerCount, nullptr, stream>>>(
            reinterpret_cast<uint8_t*>(embeddingsDevice),
            reinterpret_cast<uint8_t*>(thresholdsDevice),
            reinterpret_cast<uint8_t*>(maskDevice),
            reinterpret_cast<uint8_t*>(templatesDevice),
            reinterpret_cast<uint8_t*>(embeddingCountDevice));
        CheckAcl(aclrtSynchronizeStream(stream), "synchronize AdaMTrans");

        std::vector<uint16_t> templates(
            static_cast<std::size_t>(kEmbeddingBatch) * kTemplateBits);
        CopyDeviceToHost(templates.data(), templatesDevice, templates.size(), "templates");
        bool transformReferenceMatch = true;
        for (int32_t row = 0; row < kEmbeddingBatch; ++row) {
            for (int32_t bit = 0; bit < kTemplateBits; ++bit) {
                transformReferenceMatch = transformReferenceMatch &&
                    templates[static_cast<std::size_t>(row) * kTemplateBits + bit] ==
                        referenceTemplates[
                            static_cast<std::size_t>(row) * kTemplateBits + bit];
            }
        }
        if (!transformReferenceMatch) {
            throw std::runtime_error("CANN AdaMTrans differs from Host reference");
        }
#ifdef FUZZY_VAULT_FULL
        std::cout << "[FULL] AdaMTrans CANN/Host agreement: 12000/12000"
                  << " CANN_workers=" << kCannWorkerCount << std::endl;
#endif

        // LDPC pre-reconciliation: helper = enrollment witness XOR codeword.
        // The CANN kernel decodes probe XOR helper and reconstructs the
        // enrollment witness before it is tokenized for the Vault query.
        const std::size_t codeElements =
            static_cast<std::size_t>(kCodeBlockBatch) * kVariableCount;
        std::vector<uint16_t> probe(codeElements);
        std::vector<uint16_t> helper(codeElements);
        std::vector<int32_t> hammingErrors(kPairCount, 0);
#ifndef FUZZY_VAULT_FULL
        std::vector<DecodeResult> referenceDecode(kCodeBlockBatch);
        std::vector<uint16_t> referenceWitness(codeElements);
#endif
        std::mt19937 ldpcRandom(0xC011F17U);
        for (int32_t sample = 0; sample < kPairCount; ++sample) {
            for (int32_t block = 0; block < kBlocksPerTemplate; ++block) {
                const int32_t codeBlock = sample * kBlocksPerTemplate + block;
                const auto codeword = RandomCodeword(graph, ldpcRandom);
#ifndef FUZZY_VAULT_FULL
                std::array<uint16_t, kVariableCount> received{};
#endif
                for (int32_t bit = 0; bit < kVariableCount; ++bit) {
                    const int32_t templateBit = block * 512 + bit;
                    const uint16_t enrolledBit = bit < 512
                        ? templates[static_cast<std::size_t>(sample * 2) *
                            kTemplateBits + templateBit]
                        : 0;
                    const uint16_t probeBit = bit < 512
                        ? templates[static_cast<std::size_t>(sample * 2 + 1) *
                            kTemplateBits + templateBit]
                        : 0;
                    const std::size_t offset =
                        static_cast<std::size_t>(codeBlock) * kVariableCount + bit;
                    helper[offset] = enrolledBit ^ codeword[bit];
                    probe[offset] = probeBit;
                    hammingErrors[sample] += enrolledBit == probeBit ? 0 : 1;
#ifndef FUZZY_VAULT_FULL
                    received[bit] = probeBit ^ helper[offset];
#endif
                }
#ifndef FUZZY_VAULT_FULL
                referenceDecode[codeBlock] = ReferenceDecode(graph, received);
                for (int32_t bit = 0; bit < kVariableCount; ++bit) {
                    const std::size_t offset =
                        static_cast<std::size_t>(codeBlock) * kVariableCount + bit;
                    referenceWitness[offset] =
                        helper[offset] ^ referenceDecode[codeBlock].bits[bit];
                }
#endif
            }
        }

        uint16_t* probeDevice = AllocateDevice<uint16_t>(probe.size(), "probe");
        uint16_t* helperDevice = AllocateDevice<uint16_t>(helper.size(), "helper");
        int32_t* checkOffsetsDevice =
            AllocateDevice<int32_t>(graph.checkOffsets.size(), "checkOffsets");
        int32_t* checkVariablesDevice =
            AllocateDevice<int32_t>(graph.checkVariables.size(), "checkVariables");
        int32_t* variableOffsetsDevice =
            AllocateDevice<int32_t>(graph.variableOffsets.size(), "variableOffsets");
        int32_t* variableEdgesDevice =
            AllocateDevice<int32_t>(graph.variableEdges.size(), "variableEdges");
        uint16_t* reconstructedDevice =
            AllocateDevice<uint16_t>(codeElements, "reconstructedWitness");
        int32_t* decodeOkDevice =
            AllocateDevice<int32_t>(kCodeBlockBatch, "decodeOk");
        int32_t* syndromeWeightDevice =
            AllocateDevice<int32_t>(kCodeBlockBatch, "syndromeWeight");
        int32_t* iterationsDevice =
            AllocateDevice<int32_t>(kCodeBlockBatch, "iterations");
        int32_t* codeBlockCountDevice =
            AllocateDevice<int32_t>(1, "codeBlockCount");

        CopyHostToDevice(probeDevice, probe.data(), probe.size(), "probe");
        CopyHostToDevice(helperDevice, helper.data(), helper.size(), "helper");
        CopyHostToDevice(
            checkOffsetsDevice,
            graph.checkOffsets.data(),
            graph.checkOffsets.size(),
            "checkOffsets");
        CopyHostToDevice(
            checkVariablesDevice,
            graph.checkVariables.data(),
            graph.checkVariables.size(),
            "checkVariables");
        CopyHostToDevice(
            variableOffsetsDevice,
            graph.variableOffsets.data(),
            graph.variableOffsets.size(),
            "variableOffsets");
        CopyHostToDevice(
            variableEdgesDevice,
            graph.variableEdges.data(),
            graph.variableEdges.size(),
            "variableEdges");
        const int32_t codeBlockCount = kCodeBlockBatch;
        CopyHostToDevice(
            codeBlockCountDevice, &codeBlockCount, 1, "codeBlockCount");

#ifdef FUZZY_VAULT_FULL
        std::cout << "[FULL] Starting 18000-block CANN LDPC reconstruction..."
                  << std::endl;
#endif
        fuzzy_vault_lfw_ldpc_reconstruct<<<kCannWorkerCount, nullptr, stream>>>(
            reinterpret_cast<uint8_t*>(probeDevice),
            reinterpret_cast<uint8_t*>(helperDevice),
            reinterpret_cast<uint8_t*>(checkOffsetsDevice),
            reinterpret_cast<uint8_t*>(checkVariablesDevice),
            reinterpret_cast<uint8_t*>(variableOffsetsDevice),
            reinterpret_cast<uint8_t*>(variableEdgesDevice),
            reinterpret_cast<uint8_t*>(reconstructedDevice),
            reinterpret_cast<uint8_t*>(decodeOkDevice),
            reinterpret_cast<uint8_t*>(syndromeWeightDevice),
            reinterpret_cast<uint8_t*>(iterationsDevice),
            reinterpret_cast<uint8_t*>(codeBlockCountDevice));
        CheckAcl(aclrtSynchronizeStream(stream), "synchronize LDPC reconstruction");

        std::vector<uint16_t> reconstructed(codeElements);
        std::vector<int32_t> decodeOk(kCodeBlockBatch);
        std::vector<int32_t> syndromeWeight(kCodeBlockBatch);
        std::vector<int32_t> iterations(kCodeBlockBatch);
        CopyDeviceToHost(
            reconstructed.data(),
            reconstructedDevice,
            reconstructed.size(),
            "reconstructedWitness");
        CopyDeviceToHost(decodeOk.data(), decodeOkDevice, decodeOk.size(), "decodeOk");
        CopyDeviceToHost(
            syndromeWeight.data(),
            syndromeWeightDevice,
            syndromeWeight.size(),
            "syndromeWeight");
        CopyDeviceToHost(
            iterations.data(), iterationsDevice, iterations.size(), "iterations");

        std::vector<uint16_t> correctedTemplates(
            static_cast<std::size_t>(kPairCount) * kTemplateBits);
        std::vector<uint8_t> ldpcPipelineValid(kPairCount, 1);
        std::vector<int32_t> ldpcSyndromeZeroBlocks(kPairCount, 0);
        std::vector<int32_t> ldpcExactWitnessBlocks(kPairCount, 0);
        int64_t totalLdpcIterations = 0;
        for (int32_t sample = 0; sample < kPairCount; ++sample) {
            for (int32_t block = 0; block < kBlocksPerTemplate; ++block) {
                const int32_t codeBlock = sample * kBlocksPerTemplate + block;
                bool blockValid =
                    decodeOk[codeBlock] >= 0 && decodeOk[codeBlock] <= 1 &&
                    syndromeWeight[codeBlock] >= 0 &&
                    syndromeWeight[codeBlock] <= kCheckCount &&
                    iterations[codeBlock] >= 1 &&
                    iterations[codeBlock] <= kMaxIterations;
                bool exactWitness = true;
                totalLdpcIterations += iterations[codeBlock];
                ldpcSyndromeZeroBlocks[sample] += decodeOk[codeBlock] != 0 ? 1 : 0;
                for (int32_t bit = 0; bit < kVariableCount; ++bit) {
                    const std::size_t offset =
                        static_cast<std::size_t>(codeBlock) * kVariableCount + bit;
                    const uint16_t value = reconstructed[offset];
                    blockValid = blockValid && value <= 1;
                    const int32_t templateBit = block * 512 + bit;
                    const uint16_t enrolledBit = bit < 512
                        ? templates[static_cast<std::size_t>(sample * 2) *
                            kTemplateBits + templateBit]
                        : 0;
                    exactWitness = exactWitness && value == enrolledBit;
                    if (bit < 512) {
                        correctedTemplates[
                            static_cast<std::size_t>(sample) * kTemplateBits +
                            templateBit] = value;
                    }
#ifndef FUZZY_VAULT_FULL
                    blockValid = blockValid && value == referenceWitness[offset];
#endif
                }
#ifndef FUZZY_VAULT_FULL
                blockValid = blockValid &&
                    decodeOk[codeBlock] == referenceDecode[codeBlock].decodeOk &&
                    syndromeWeight[codeBlock] ==
                        referenceDecode[codeBlock].syndromeWeight &&
                    iterations[codeBlock] == referenceDecode[codeBlock].iterations;
#endif
                ldpcPipelineValid[sample] =
                    static_cast<uint8_t>(ldpcPipelineValid[sample] != 0 && blockValid);
                ldpcExactWitnessBlocks[sample] += exactWitness ? 1 : 0;
            }
        }

        CheckAcl(aclrtFree(probeDevice), "free probe");
        CheckAcl(aclrtFree(helperDevice), "free helper");
        CheckAcl(aclrtFree(checkOffsetsDevice), "free checkOffsets");
        CheckAcl(aclrtFree(checkVariablesDevice), "free checkVariables");
        CheckAcl(aclrtFree(variableOffsetsDevice), "free variableOffsets");
        CheckAcl(aclrtFree(variableEdgesDevice), "free variableEdges");
        CheckAcl(aclrtFree(reconstructedDevice), "free reconstructedWitness");
        CheckAcl(aclrtFree(decodeOkDevice), "free decodeOk");
        CheckAcl(aclrtFree(syndromeWeightDevice), "free syndromeWeight");
        CheckAcl(aclrtFree(iterationsDevice), "free iterations");
        CheckAcl(aclrtFree(codeBlockCountDevice), "free codeBlockCount");

#ifdef FUZZY_VAULT_FULL
        const int32_t validLdpcPairs = static_cast<int32_t>(std::count(
            ldpcPipelineValid.begin(),
            ldpcPipelineValid.end(),
            static_cast<uint8_t>(1)));
        std::cout << "[FULL] Valid CANN LDPC pipeline pairs: " << validLdpcPairs
                  << "/" << kPairCount << std::endl;
#endif

        std::vector<int32_t> vaultX(
            static_cast<std::size_t>(kPairCount) * kVaultPointCount);
        std::vector<int32_t> vaultY(
            static_cast<std::size_t>(kPairCount) * kVaultPointCount);
        std::vector<int32_t> queryX(
            static_cast<std::size_t>(kPairCount) * kQueryCount);
        std::vector<FuzzyVaultLfwDigest> enrolledDigests(kPairCount);
        std::vector<MatchResult> referenceMatches(kPairCount);
        std::mt19937 random(0xFA0171F0U);

        for (int32_t sample = 0; sample < kPairCount; ++sample) {
            const auto enrollmentTokens = TemplateToTokens(
                templates.data() + (sample * 2) * kTemplateBits);
            const auto correctedProbeTokens = TemplateToTokens(
                correctedTemplates.data() +
                    static_cast<std::size_t>(sample) * kTemplateBits);
            FuzzyVaultLfwCoefficients coefficients{};
            for (int32_t index = 0; index < kRequiredMatchCount; ++index) {
                coefficients[index] = RandomFieldValue(random);
            }
            if (coefficients[kPolynomialDegree] == 0) {
                coefficients[kPolynomialDegree] = 1;
            }
            enrolledDigests[sample] = FuzzyVaultLfwHashCoefficients(coefficients);

            std::vector<std::pair<int32_t, int32_t>> points;
            std::set<int32_t> usedX;
            for (const int32_t x : enrollmentTokens) {
                usedX.insert(x);
                points.emplace_back(x, EvaluatePolynomial(coefficients, x));
            }
            while (static_cast<int32_t>(points.size()) < kVaultPointCount) {
                const int32_t x = kChaffDomainStart + static_cast<int32_t>(
                    Random64(random) %
                    static_cast<uint64_t>(kPrime - kChaffDomainStart));
                if (!usedX.insert(x).second) {
                    continue;
                }
                int32_t y = RandomFieldValue(random);
                const int32_t polynomialY = EvaluatePolynomial(coefficients, x);
                if (y == polynomialY) {
                    y = y == kPrime - 1 ? 0 : y + 1;
                }
                points.emplace_back(x, y);
            }
            std::shuffle(points.begin(), points.end(), random);
            for (int32_t index = 0; index < kVaultPointCount; ++index) {
                vaultX[sample * kVaultPointCount + index] = points[index].first;
                vaultY[sample * kVaultPointCount + index] = points[index].second;
            }
            std::copy(
                correctedProbeTokens.begin(),
                correctedProbeTokens.end(),
                queryX.begin() + sample * kQueryCount);
            referenceMatches[sample] = ReferenceMatch(
                vaultX.data() + sample * kVaultPointCount,
                vaultY.data() + sample * kVaultPointCount,
                queryX.data() + sample * kQueryCount);
        }

        int32_t* vaultXDevice = AllocateDevice<int32_t>(vaultX.size(), "vaultX");
        int32_t* vaultYDevice = AllocateDevice<int32_t>(vaultY.size(), "vaultY");
        int32_t* queryXDevice = AllocateDevice<int32_t>(queryX.size(), "queryX");
        int32_t* matchedXDevice =
            AllocateDevice<int32_t>(kPairCount * kMaxMatchedCount, "matchedX");
        int32_t* matchedYDevice =
            AllocateDevice<int32_t>(kPairCount * kMaxMatchedCount, "matchedY");
        int32_t* matchCountDevice = AllocateDevice<int32_t>(kPairCount, "matchCount");
        int32_t* pairCountDevice = AllocateDevice<int32_t>(1, "pairCount");
        CopyHostToDevice(vaultXDevice, vaultX.data(), vaultX.size(), "vaultX");
        CopyHostToDevice(vaultYDevice, vaultY.data(), vaultY.size(), "vaultY");
        CopyHostToDevice(queryXDevice, queryX.data(), queryX.size(), "queryX");
        const int32_t pairCount = kPairCount;
        CopyHostToDevice(pairCountDevice, &pairCount, 1, "pairCount");

        fuzzy_vault_lfw_match_points<<<kCannWorkerCount, nullptr, stream>>>(
            reinterpret_cast<uint8_t*>(vaultXDevice),
            reinterpret_cast<uint8_t*>(vaultYDevice),
            reinterpret_cast<uint8_t*>(queryXDevice),
            reinterpret_cast<uint8_t*>(matchedXDevice),
            reinterpret_cast<uint8_t*>(matchedYDevice),
            reinterpret_cast<uint8_t*>(matchCountDevice),
            reinterpret_cast<uint8_t*>(pairCountDevice));
        CheckAcl(aclrtSynchronizeStream(stream), "synchronize vault matching");

        std::vector<int32_t> matchedX(
            static_cast<std::size_t>(kPairCount) * kMaxMatchedCount);
        std::vector<int32_t> matchedY(
            static_cast<std::size_t>(kPairCount) * kMaxMatchedCount);
        std::vector<int32_t> matchCount(kPairCount);
        CopyDeviceToHost(matchedX.data(), matchedXDevice, matchedX.size(), "matchedX");
        CopyDeviceToHost(matchedY.data(), matchedYDevice, matchedY.size(), "matchedY");
        CopyDeviceToHost(matchCount.data(), matchCountDevice, matchCount.size(), "matchCount");

        int32_t pipelinePassed = 0;
        int32_t classificationCorrect = 0;
        int32_t truePositive = 0;
        int32_t trueNegative = 0;
        int32_t falsePositive = 0;
        int32_t falseNegative = 0;
        int64_t positiveOverlapSum = 0;
        int64_t negativeOverlapSum = 0;
        int32_t positiveCount = 0;
        int32_t negativeCount = 0;
        for (int32_t sample = 0; sample < kPairCount; ++sample) {
            bool referenceMatch = matchCount[sample] == referenceMatches[sample].count;
            for (int32_t index = 0; index < kMaxMatchedCount; ++index) {
                referenceMatch = referenceMatch &&
                    matchedX[sample * kMaxMatchedCount + index] ==
                        referenceMatches[sample].x[index] &&
                    matchedY[sample * kMaxMatchedCount + index] ==
                        referenceMatches[sample].y[index];
            }

            bool accepted = false;
            if (matchCount[sample] >= kVaultUnlockMatchCount) {
                std::array<int32_t, kMaxMatchedCount> caseX{};
                std::array<int32_t, kMaxMatchedCount> caseY{};
                for (int32_t index = 0; index < kMaxMatchedCount; ++index) {
                    caseX[index] = matchedX[sample * kMaxMatchedCount + index];
                    caseY[index] = matchedY[sample * kMaxMatchedCount + index];
                }
                FuzzyVaultLfwCoefficients recovered{};
                if (InterpolatePolynomial(caseX, caseY, recovered)) {
                    accepted = FuzzyVaultLfwDigestEqual(
                        FuzzyVaultLfwHashCoefficients(recovered),
                        enrolledDigests[sample]);
                }
            }
            const bool expected = dataset.labels[pairIndices[sample]] != 0;
            const bool classifiedCorrectly = accepted == expected;
            const bool hybridReferenceMatch =
                referenceMatch && ldpcPipelineValid[sample] != 0;
            pipelinePassed += hybridReferenceMatch ? 1 : 0;
            classificationCorrect += classifiedCorrectly ? 1 : 0;
            if (expected) {
                positiveOverlapSum += matchCount[sample];
                ++positiveCount;
            } else {
                negativeOverlapSum += matchCount[sample];
                ++negativeCount;
            }
            if (expected && accepted) {
                ++truePositive;
            } else if (expected) {
                ++falseNegative;
            } else if (accepted) {
                ++falsePositive;
            } else {
                ++trueNegative;
            }
#ifdef FUZZY_VAULT_FULL
            if ((sample + 1) % 500 == 0) {
                std::cout << "[FULL] evaluated " << sample + 1 << "/" << kPairCount
                          << " pairs" << std::endl;
            }
#else
            std::cout << (hybridReferenceMatch ? "[PASS]" : "[FAIL]")
                      << "[PAIR_" << std::setw(2) << std::setfill('0') << sample
                      << std::setfill(' ') << "] lfw_pair=" << pairIndices[sample]
                      << " label=" << (expected ? "positive" : "negative")
                      << " masked_errors=" << hammingErrors[sample]
                      << "/" << kTemplateBits
                      << " ldpc_syndrome_zero_blocks="
                      << ldpcSyndromeZeroBlocks[sample]
                      << "/" << kBlocksPerTemplate
                      << " ldpc_exact_witness_blocks="
                      << ldpcExactWitnessBlocks[sample]
                      << "/" << kBlocksPerTemplate
                      << " token_overlap=" << matchCount[sample] << "/" << kTokenCount
                      << " unlock_threshold=" << kVaultUnlockMatchCount
                      << " interpolation_points=" << kRequiredMatchCount
                      << " accepted=" << (accepted ? "yes" : "no")
                      << " classification=" << (classifiedCorrectly ? "correct" : "wrong")
                      << " hybrid_reference_match="
                      << (hybridReferenceMatch ? "yes" : "no")
                      << std::endl;
#endif
        }

        CheckAcl(aclrtFree(embeddingsDevice), "free embeddings");
        CheckAcl(aclrtFree(thresholdsDevice), "free thresholds");
        CheckAcl(aclrtFree(maskDevice), "free mask");
        CheckAcl(aclrtFree(templatesDevice), "free templates");
        CheckAcl(aclrtFree(embeddingCountDevice), "free embeddingCount");
        CheckAcl(aclrtFree(vaultXDevice), "free vaultX");
        CheckAcl(aclrtFree(vaultYDevice), "free vaultY");
        CheckAcl(aclrtFree(queryXDevice), "free queryX");
        CheckAcl(aclrtFree(matchedXDevice), "free matchedX");
        CheckAcl(aclrtFree(matchedYDevice), "free matchedY");
        CheckAcl(aclrtFree(matchCountDevice), "free matchCount");
        CheckAcl(aclrtFree(pairCountDevice), "free pairCount");
        CheckAcl(aclrtDestroyStream(stream), "destroy stream");
        CheckAcl(aclrtResetDevice(0), "reset device");
        CheckAcl(aclFinalize(), "aclFinalize");

#ifdef FUZZY_VAULT_FULL
        const double gmr = static_cast<double>(truePositive) /
            (truePositive + falseNegative);
        const double fmr = static_cast<double>(falsePositive) /
            (falsePositive + trueNegative);
        const double fnmr = static_cast<double>(falseNegative) /
            (truePositive + falseNegative);
        const double accuracy = static_cast<double>(truePositive + trueNegative) /
            kPairCount;
        const double seconds = std::chrono::duration<double>(
            std::chrono::steady_clock::now() - startTime).count();
        std::cout << std::fixed << std::setprecision(6)
                  << "[FULL_RESULT] TP=" << truePositive
                  << " TN=" << trueNegative
                  << " FP=" << falsePositive
                  << " FN=" << falseNegative << std::endl
                  << "[FULL_RESULT] accuracy=" << accuracy
                  << " GMR=" << gmr
                  << " FMR=" << fmr
                  << " FNMR=" << fnmr << std::endl
                  << "[FULL_RESULT] average_positive_token_overlap="
                  << static_cast<double>(positiveOverlapSum) / positiveCount
                  << " average_negative_token_overlap="
                  << static_cast<double>(negativeOverlapSum) / negativeCount << std::endl
                  << "[FULL_RESULT] valid_ldpc_pipeline_pairs=" << validLdpcPairs
                  << "/" << kPairCount
                  << " average_ldpc_iterations="
                  << static_cast<double>(totalLdpcIterations) / kCodeBlockBatch
                  << std::endl
                  << "[FULL_RESULT] valid_hybrid_pipeline_pairs=" << pipelinePassed
                  << "/" << kPairCount
                  << " elapsed_seconds=" << seconds << std::endl;
        if (pipelinePassed != kPairCount) {
            return EXIT_FAILURE;
        }
        std::cout << "[PASS] Full 6000-pair LDPC + fuzzy vault CANN evaluation completed."
                  << std::endl;
#else
        std::cout << "[RESULT] CANN/Host hybrid pipeline agreement: " << pipelinePassed
                  << "/" << kPairCount << std::endl;
        std::cout << "[RESULT] Biometric classification: " << classificationCorrect
                  << "/" << kPairCount
                  << " (five positive + five negative; accuracy is not a pass condition)"
                  << std::endl;
        if (pipelinePassed != kPairCount) {
            return EXIT_FAILURE;
        }
        std::cout << "[PASS] LDPC + fuzzy vault LFW CANN pipeline completed."
                  << std::endl;
#endif
        return EXIT_SUCCESS;
    } catch (const std::exception& error) {
        std::cerr << "[FAIL] " << error.what() << std::endl;
        return EXIT_FAILURE;
    }
}

